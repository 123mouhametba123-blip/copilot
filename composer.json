{
    "name": "universite/reservation-salles",
    "description": "Gestion des reservations de salles universitaires",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public public/index.php",
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "test": "phpunit"
    }
}